# ==========================================
# InterviewIQ AI - Environment Configuration
# ==========================================

# Port Configuration
PORT=5000

# Database Configuration (PostgreSQL)
# Local Docker development URL: postgresql://postgres:postgres@localhost:5432/interviewiq?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interviewiq?schema=public"

# Redis Configuration (Cache & Session)
# Local Docker Redis URL: redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# JWT Authentication Secrets (Generate secure random keys in production)
JWT_SECRET="super-secret-access-token-key-change-this-in-production"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-this-in-production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# External API Integrations (Fill these with actual keys for functionality)
# Resend API Key for Email verification/OTP
RESEND_API_KEY="re_123456789"
EMAIL_FROM="noreply@interviewiq.ai"

# Google OAuth
GOOGLE_CLIENT_ID="google-client-id-here"
GOOGLE_CLIENT_SECRET="google-client-secret-here"

# GitHub OAuth
GITHUB_CLIENT_ID="github-client-id-here"
GITHUB_CLIENT_SECRET="github-client-secret-here"

# Gemini 2.5 API Key (Required for AI Agents)
GEMINI_API_KEY="ai-gemini-key-here"

# Speech & Voice APIs
ELEVENLABS_API_KEY="elevenlabs-key-here"
# Note: Whisper is used via OpenAI API or another provider. 
# If OpenAI is used: OPENAI_API_KEY="openai-key-here"

# Company Research API (Tavily)
Tavily_API_KEY="tavily-key-here"

# Code Execution API (Judge0)
JUDGE0_API_KEY="judge0-key-here"
JUDGE0_URL="https://api.judge0.com" # Or local instance

# Cloud Storage Configuration (Cloudinary or AWS S3)
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
